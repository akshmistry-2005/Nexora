# =============================================================================
# NEXORA — Local Environment Configuration Example
# Copy this file to `.env` for local development. Never commit `.env` or real secrets.
# =============================================================================

# Application
APP_NAME=Nexora Enterprise Data Intelligence Platform
APP_ENV=development
APP_VERSION=0.2.0
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose Local Defaults)
POSTGRES_USER=nexora_user
POSTGRES_PASSWORD=nexora_local_dev_password_change_me
POSTGRES_DB=nexora_db
POSTGRES_TEST_DB=nexora_test_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Database URLs (SQLAlchemy psycopg3 driver)
DATABASE_URL=postgresql+psycopg://nexora_user:nexora_local_dev_password_change_me@localhost:5432/nexora_db
TEST_DATABASE_URL=postgresql+psycopg://nexora_user:nexora_local_dev_password_change_me@localhost:5432/nexora_test_db

# Backend API & CORS
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Security (used starting Module 5 — generate strong local values)
JWT_SECRET_KEY=replace-with-a-random-64-char-local-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
OWNER_EMAIL=owner@nexora.local
OWNER_INITIAL_PASSWORD=replace-with-local-owner-password

# Data Ingestion & Export Limits (used starting Modules 7 & 10)
MAX_UPLOAD_SIZE_MB=10
MAX_EXPORT_ROWS=50000

# Frontend (Vite public runtime config — NEVER put secrets here)
VITE_API_BASE_URL=http://127.0.0.1:8000
