# Environment & Secrets (never commit real secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo

# Local uploaded/generated artifacts (keep directory markers)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/model_metadata/*.joblib
artifacts/model_metadata/*.pkl

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
